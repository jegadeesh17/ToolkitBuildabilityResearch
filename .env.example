# Copy to .env and fill in your own keys. Never commit .env.
#   cp .env.example .env

# --- Secrets (bring your own) ---
# OpenRouter: https://openrouter.ai/keys  (set a credit limit on the key)
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
# Composio: dedicated project, no connected accounts (search/fetch tools only)
COMPOSIO_API_KEY=REPLACE_ME

# --- Models (OpenRouter slugs) ---
# Pinned to the models used for the reported results. PASS1_MODEL is confirmed by the
# 10-app pilot (scripts/pilot_compare.py); update this file if the pilot picks another.
MODEL_PRESET=paid
PASS1_MODEL=deepseek/deepseek-v4-flash
# Must be a different model family from PASS1_MODEL
VERIFY_MODEL=openai/gpt-5.6-luna
# Adjudicates disputed fields only
JUDGE_MODEL=anthropic/claude-sonnet-5

# $0 alternative (slower; :free models are rate-limited to 20 req/min):
# MODEL_PRESET=free
# PASS1_MODEL=qwen/qwen3.8-27b:free
# VERIFY_MODEL=google/gemma-4-31b-it:free
# JUDGE_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# --- Guardrails ---
# The agent refuses to start a call once logged spend reaches this cap (exit code 4)
BUDGET_CAP_USD=4.00
